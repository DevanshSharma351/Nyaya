# ---------------------------------------------------------------------------
# Nyaya configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

NYAYA_ENV=local
NYAYA_LOG_LEVEL=INFO

# --- API ---
# Browser origins allowed to call the API. Listed rather than wildcarded: this
# API returns compliance findings and must not be readable from any page. The
# default covers `next dev` (3000) and a local production build (3100); set this
# explicitly when the frontend is served from anywhere else, or every request
# will fail as "Failed to fetch" with a healthy server behind it.
# NYAYA_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Postgres (host port 5433 to avoid clashing with a local pg install) ---
POSTGRES_USER=nyaya
POSTGRES_PASSWORD=nyaya_dev_pw
POSTGRES_DB=nyaya
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Object storage (source documents) ---
MINIO_ROOT_USER=nyaya
MINIO_ROOT_PASSWORD=nyaya_dev_pw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Keycloak (only started with: docker compose --profile full up) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081

# ---------------------------------------------------------------------------
# LLM routing.
#
# Agents are assigned to a *role*, not to a vendor. Each role resolves to a
# provider:model pair, so the whole system can be re-pointed (local -> free
# tier -> paid) by editing these lines alone.
#
#   reasoning   : extraction, conflict adjudication, compliance mapping
#   fast        : classification, routing, short structured calls
#   embedding   : retrieval vectors
#
# Providers: ollama | gemini | groq | anthropic | echo(test double)
# ---------------------------------------------------------------------------
NYAYA_LLM_REASONING=ollama:qwen3:8b
NYAYA_LLM_FAST=ollama:llama3.1:8b
NYAYA_LLM_EMBEDDING=ollama:bge-m3

# Free-tier keys. Leave blank to stay fully local.
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval tuning ---
NYAYA_RETRIEVAL_TOP_K=40
NYAYA_RERANK_TOP_N=8
NYAYA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NYAYA_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# --- Observability (optional, self-hosted Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
