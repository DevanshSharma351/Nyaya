      "isDeleted": false,
      "boundElements": null,
      "updated": 1728000000000,
      "link": null,
      "locked": false,
      "text": "Architecture Invariants: A state graph, not an autonomous swarm. In regulated compliance, agent-to-agent negotiation is a liability.\nEvery transition is checkpointed, every citation is verified against versioned text, and no run proceeds past a human gate without authorized clearance.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Architecture Invariants: A state graph, not an autonomous swarm. In regulated compliance, agent-to-agent negotiation is a liability.\nEvery transition is checkpointed, every citation is verified against versioned text, and no run proceeds past a human gate without authorized clearance.",
      "lineHeight": 1.25
    }
