    {
      "id": "text_ad761653",
      "type": "text",
      "x": 675,
      "y": 815,
      "width": 514.7499999999999,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
