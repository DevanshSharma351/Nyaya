      "roundness": null,
      "seed": 503438,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1728000000000,
      "link": null,
      "locked": false,
      "text": "Declarative Regulatory Rule Packs (YAML):\n \u2022 evaluates requirement facts against regulations (e.g. ekyc-in.yaml)\n \u2022 checks statutory obligations: data retention, encryption, audit logs\n\nBlocking Gap Identification & Gate 3:\n \u2022 flags uncovered mandatory controls before system build\n \u2022 Human Gate 3 requires compliance officer sign-off or gap waiver",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12.5,
      "containerId": null,
      "originalText": "Declarative Regulatory Rule Packs (YAML):\n \u2022 evaluates requirement facts against regulations (e.g. ekyc-in.yaml)\n \u2022 checks statutory obligations: data retention, encryption, audit logs\n\nBlocking Gap Identification & Gate 3:\n \u2022 flags uncovered mandatory controls before system build\n \u2022 Human Gate 3 requires compliance officer sign-off or gap waiver",
      "lineHeight": 1.25
    },
